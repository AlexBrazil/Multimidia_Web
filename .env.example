###############################################################################
# 🌍 CONFIGURAÇÕES GERAIS DO DJANGO
###############################################################################

# Define se o Django roda em modo debug (1 = ativo, 0 = desativado)
# ⚠️ Em produção (VPS) sempre use 0
DJANGO_DEBUG=1

# Chave secreta do Django — usada para assinar cookies e tokens
# Gere uma nova com: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY="troque-por-uma-chave-segura"

# Idioma e fuso horário padrão do sistema
DJANGO_LANGUAGE_CODE=pt-br
DJANGO_TIME_ZONE=America/Sao_Paulo


###############################################################################
# 🖥️ HOSTS E SEGURANÇA
###############################################################################

# Domínios ou IPs autorizados a servir o site.
# Exemplo para produção: DJANGO_ALLOWED_HOSTS=minhacnhonline.com.br,www.minhacnhonline.com.br
# Para ambiente local, mantenha: 127.0.0.1,localhost
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Origem confiável para requisições CSRF (usada no painel admin e formulários)
# Exemplo: https://minhacnhonline.com.br,https://www.minhacnhonline.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Segurança extra em produção (HTTPS + cabeçalhos)
# Em DEV mantenha 0; na VPS configure 1
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0


###############################################################################
# 🗄️ BANCO DE DADOS
###############################################################################

# URL de conexão no formato:
# postgres://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#
# Exemplo de produção (VPS):
# DJANGO_DB_URL=postgres://multimidia:SENHA-MUITO-FORTE-AQUI@10.0.0.3:5432/multimidia
#
# Em ambiente local, se deixar comentado, o sistema usará automaticamente o SQLite.
# DJANGO_DB_URL=postgres://USER:PASSWORD@HOST:PORT/NAME


###############################################################################
# 📦 ARQUIVOS ESTÁTICOS E MÍDIA
###############################################################################

# Esses valores geralmente são fixos e definidos no settings.py:
# STATIC_URL=/static/
# MEDIA_URL=/media/
# (Você pode sobrescrever se usar storage externo, como S3, futuramente.)


###############################################################################
# 👥 AUTENTICAÇÃO E LOGIN
###############################################################################

# URLs de redirecionamento (já configuradas no settings.py, aqui apenas se quiser mudar)
# LOGIN_URL=/login/
# LOGIN_REDIRECT_URL=/
# LOGOUT_REDIRECT_URL=/login/


###############################################################################
# ⚙️ LOGS E MONITORAMENTO (opcional)
###############################################################################

# Exemplo de nível de log: DEBUG, INFO, WARNING, ERROR
# DJANGO_LOG_LEVEL=INFO

# Exemplo de integração futura com Sentry ou Prometheus
# SENTRY_DSN=https://<token>@sentry.io/<project>


###############################################################################
# 🧩 OUTROS (reserva para variáveis personalizadas)
###############################################################################

# Exemplo: caminho para arquivos protegidos
# PROTECTED_PATH=/srv/minhacnhonline/protected
